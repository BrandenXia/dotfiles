# setopt
setopt extended_history
setopt HIST_IGNORE_SPACE
setopt EXTENDED_GLOB

# editor
export EDITOR=nvim
export MANPAGER='nvim +Man!'

# alias
alias vi=nvim
alias vim=nvim
alias ls="eza --icons=auto"
alias ll="ls -l"
alias la="ls -la"
alias lg=lazygit
alias sys=fastfetch
alias ra=yazi
alias s="kitten ssh"
